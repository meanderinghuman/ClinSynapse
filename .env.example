# Virginia Tech ARC LLM API (OpenAI-compatible).
# Key: llm.arc.vt.edu → Settings → Account → API keys
OPEN_AI_ENDPOINT=https://llm-api.arc.vt.edu/api/v1
OPEN_AI_API_KEY=
OPEN_AI_MODEL=gpt-oss-120b

# Optional overrides
# CS_SMALL_MODEL=gpt-oss-120b         # router
# CS_ALT_MODEL=DeepSeek-V4.1-Flash    # head-to-head comparison model
# CS_MAX_CONCURRENCY=8                # ARC: 10 concurrent per model, 20 per user

# Retrieval device: mps (Apple Silicon), cuda, or cpu
# CS_DEVICE=mps

# Optional Langfuse tracing (uv sync --group obs)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
